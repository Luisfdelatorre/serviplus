# Postgres. En desarrollo: `npm run db:up` levanta el contenedor local (puerto 5433).
DATABASE_URL="postgresql://serviplus:serviplus_dev@localhost:5433/serviplus_vendor?schema=public"
# Conexión directa para migraciones. En Neon: la URL sin "-pooler"; DATABASE_URL usa el pooler con &pgbouncer=true.
DIRECT_URL="postgresql://serviplus:serviplus_dev@localhost:5433/serviplus_vendor?schema=public"

# Generadas por `npm run keys:generate` (escribe .env.local). NUNCA commitear.
# LICENSE_SIGNING_PRIVATE_KEY=  (PKCS8 DER en base64, Ed25519)
# LICENSE_SIGNING_PUBLIC_KEY=   (SPKI DER en base64; la que se embebe en la app)
# ESCROW_MASTER_KEY=            (32 bytes en base64)
# SESSION_SECRET=               (32+ bytes en base64)

# Número de proxies propios delante de la app (p. ej. 1 con nginx/Caddy). Sin esto se ignora
# X-Forwarded-For y el rate-limit es global por ruta. En producción detrás de un proxy: 1.
# TRUST_PROXY_HOPS=1

# Operador inicial para `npm run db:seed`
SEED_OPERATOR_EMAIL="admin@serviplus.local"
SEED_OPERATOR_NAME="Administrador"
# SEED_OPERATOR_PASSWORD=       (mínimo 12 caracteres)
