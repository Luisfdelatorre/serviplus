{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server-sqlite",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server/index.js"
      ],
      "env": {
        "PORT": "3080",
        "DB_DRIVER": "sqlite"
      },
      "port": 3080
    },
    {
      "name": "client-vite",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "server-licensed",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server/index.js"
      ],
      "env": {
        "PORT": "3081",
        "DB_DRIVER": "sqlite",
        "SP_LICENSE_ENFORCE": "1",
        "SP_DATA_DIR": "data/license-dev",
        "SP_LICENSE_SERVER_URL": "http://localhost:3100"
      },
      "port": 3081
    }
  ]
}