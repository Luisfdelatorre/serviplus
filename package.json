{
  "name": "serviplus",
  "main": "index.html",
  "description": "sever",
  "scripts": {
    "start": "node server/index.js",
    "kiosk": "node server/index.js",
    "legacy": "node server.js",
    "simulate": "node simulate_orders_session.js",
    "simulate:fast": "node simulate_orders_session.js --speed 10",
    "build:client": "cd client && npm run build",
    "dev:client": "cd client && npm run dev",
    "dev:pm2": "npx pm2 start ecosystem.config.js --env development",
    "pm2:stop": "npx pm2 stop ecosystem.config.js",
    "pm2:restart": "npx pm2 restart ecosystem.config.js",
    "pm2:logs": "npx pm2 logs",
    "pm2:status": "npx pm2 status"
  },
  "window": {
    "title": "SeriPlus",
    "show": true,
    "toolbar": true,
    "frame": true,
    "position": "mouse",
    "width": 300,
    "height": 40,
    "min_width": 300,
    "min_height": 40,
    "resizable": false
  },
  "dependencies": {
    "body-parser": "^1.12.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "jsonwebtoken": "^5.0.0",
    "mime-db": "^1.54.0",
    "mime-types": "^3.0.2",
    "moment": "^2.31.0",
    "node-adodb": "^5.0.3",
    "socket.io": "^4.8.4"
  }
}